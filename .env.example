# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexace-crm?retryWrites=true&w=majority

# JWT Session Encryption Key (must be a secure key of at least 32 characters/bytes)
SESSION_SECRET=your_32_character_long_session_secret_key

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="NexAce CRM <noreply@yourdomain.com>"
