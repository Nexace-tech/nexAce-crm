# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexace-crm?retryWrites=true&w=majority

# JWT Session Encryption Key (must be a secure key of at least 32 characters/bytes)
SESSION_SECRET=replace_with_a_secure_random_string_of_at_least_32_chars

# Nodemailer SMTP Configuration (Add actual values to .env.local — NEVER commit real credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_app_password
SMTP_FROM="NexAce CRM <your_smtp_username>"

# Firebase Cloud Messaging Service Account (HTTP V1 API for mobile push notifications)
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Paste the entire JSON as a single-line string:
FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"nexace-crm",...}'

